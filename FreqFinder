#!/usr/bin/env python3
"""Runtime launcher for FreqFinder.

Runs the application in GUI mode by default with no switches.
"""
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
FREQFINDER = os.path.join(HERE, 'freqfinder.py')

if not os.path.exists(FREQFINDER):
    raise FileNotFoundError(f'Could not find {FREQFINDER}. Please ensure this repository contains freqfinder.py.')

# Launch the main application script directly.
os.execv(sys.executable, [sys.executable, FREQFINDER] + sys.argv[1:])
