{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch media/index.html",
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "file": "${workspaceFolder}/media/index.html"
        },
        {
            "name": "Launch localhost",
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "url": "http://localhost/media/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Attach",
            "type": "firefox",
            "request": "attach"
        },
        {
            "name": "Bash: Run script (bashdb)",
            "type": "bashdb",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/example.sh",
            "args": [],
            "cwd": "${workspaceFolder}",
            "terminalKind": "integrated"
        },
        {
            "name": "Bash: Run remote SSH script",
            "type": "bashdb",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/remote.sh",
            "args": [],
            "cwd": "${workspaceFolder}",
            "terminalKind": "integrated",
            "env": {
                "SSH_AUTH_SOCK": "${env:SSH_AUTH_SOCK}"
            }
        },
        {
            "name": "Launch WebExtension",
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "addonPath": "${workspaceFolder}"
        }
    ]
}